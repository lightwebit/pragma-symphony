# Rust build output (workspace-level)
/target/

# Node dependencies
node_modules/

# Vite build output
dist/

# Tauri generated files (rebuilt on cargo build)
src-tauri/gen/

# Tauri WiX bundler (downloaded on tauri build)
src-tauri/WixTools/

# Tauri Android/iOS build output (not targeting mobile)
src-tauri/gen/android/
src-tauri/gen/apple/

# Temporary icon source (was used for icon generation)
src-tauri/icon_source.jpg

# Local scratch / personal notes — not part of the codebase
_NOTE.txt
V2.txt

# Editor
.vscode/
.idea/

# Local Claude Code settings (personal, not part of the codebase)
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# Playwright test run artifacts (component testing — see .autotest/playwright/)
test-results/
playwright-report/
.autotest/**/.cache/

# Tauri E2E (see .autotest/wdio/): throwaway ~/.pragma the app runs against,
# plus the config and capability files generated for the E2E-only build
.autotest/wdio/.sandbox-home/
.autotest/wdio/.tauri.e2e.json
src-tauri/capabilities/wdio.e2e.json

# VERIFY+REVIEW field test (see .autotest/wdio-review/): throwaway ~/.pragma,
# seeded with real Claude credentials paths — never committed
.autotest/wdio-review/.sandbox-home/


__SECURITY_PRAGMA.txt
# Build web (npm run build:web), da lì si pubblica nel repo del sito
dist-web/
.autotest/wdio/.sandbox-shots/
